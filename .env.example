# No paid API keys are required to run this website.
# All data is stored locally in SQLite and all visual assets are bundled locally.

# APP_URL: Public URL of your website / backend (used for sitemap.xml and canonical SEO tags).
APP_URL="https://mujahidservices.com"

# SESSION_SECRET: Secret key used to sign admin HttpOnly session cookies.
SESSION_SECRET="change-this-to-a-long-random-secret"

# ADMIN_INITIAL_PASSWORD: Initial password for the seeded 'admin' account (change after first login).
ADMIN_INITIAL_PASSWORD="Mujahid@2026"

# Optional (only needed if Frontend and Backend are hosted on separate domains):
# Frontend (.env): VITE_API_URL="https://api.mujahidservices.com"
# Backend (.env):  FRONTEND_URL="https://mujahidservices.com"

